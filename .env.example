# Alist 配置
# Alist 服务地址 (使用 host 网络模式时填写 http://127.0.0.1:5244)
ALIST_HOST=http://127.0.0.1:5244
ALIST_USERNAME=admin
ALIST_PASSWORD=change_me

# 云端基础保存路径
ALIST_PATH_TV=/pikpak/Media/TV
ALIST_PATH_MOVIE=/pikpak/Media/Movie

# 本地监控路径配置
# 对应TV
WATCH_DIR_TV=/data/downloads/incoming/TV
# 对应电影
WATCH_DIR_MOVIE=/data/downloads/incoming/Movie
#归档路径
PROCESSED_DIR=/data/processed

# 检查间隔 (秒)
CHECK_INTERVAL=10

# 可选: 电影拍平完成后，额外刷新并确认 CD2 已看到最终电影目录
CD2_REFRESH_ENABLED=false
CD2_HOST=http://your-cd2-host:19798
CD2_TOKEN=your_cd2_token_here
CD2_MOVIE_BASE_PATH=/WebDAV/Media/Movie
CD2_REFRESH_POLL_INTERVAL=10
CD2_REFRESH_MAX_ATTEMPTS=5
